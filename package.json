{
  "name": "caletzza-theme",
  "version": "1.0.0",
  "description": "Caletzza Theme — Shopify theme + COD express app (Render) + pack builder",
  "private": true,
  "scripts": {
    "shopify": "shopify",
    "theme:list": "shopify theme list -e default",
    "theme:pull": "shopify theme pull -e default",
    "theme:dev": "shopify theme dev -e default",
    "theme:push": "shopify theme push -e default --unpublished --json",
    "theme:push:draft": "shopify theme push -e default --unpublished --json",
    "theme:check": "shopify theme check",
    "cod:dev": "npm --prefix cod-express-app run dev",
    "cod:start": "npm --prefix cod-express-app start"
  },
  "keywords": ["shopify", "theme", "caletzza", "cod", "pack"],
  "author": "Caletzza",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@shopify/cli": "^4.4.0",
    "@shopify/theme": "^3.58.2"
  }
}
