{
  "name": "caletzza-theme",
  "version": "1.0.0",
  "description": "Caletzza Theme — Shopify theme con pack builder, COD UI, prueba social y diseño tienda lencería",
  "private": true,
  "scripts": {
    "shopify": "shopify",
    "theme:list": "shopify theme list -e default",
    "theme:pull": "shopify theme pull -e default",
    "theme:dev": "shopify theme dev -e default",
    "theme:push": "shopify theme push -e default --unpublished --json",
    "theme:push:draft": "shopify theme push -e default --unpublished --json",
    "theme:check": "shopify theme check"
  },
  "keywords": ["shopify", "theme", "caletzza", "lingerie"],
  "author": "Caletzza",
