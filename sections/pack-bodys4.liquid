{% liquid
  assign pack_collection = collections[section.settings.collection]
  assign slot_count = section.settings.slot_count | default: 4
  assign products_limit = section.settings.products_limit | default: 24

  if slot_count <= 4
    assign pack_rows = 1
  elsif slot_count <= 12
    assign pack_rows = 2
  else
    assign pack_rows = 3
  endif

  assign pack_cols = slot_count | plus: pack_rows | minus: 1 | divided_by: pack_rows

  if slot_count == 4
    assign pack_rows_mobile = 2
    assign pack_cols_mobile = 2
  elsif slot_count <= 10
    assign pack_rows_mobile = 2
    assign pack_cols_mobile = slot_count | plus: 1 | divided_by: 2
  else
    assign pack_rows_mobile = 3
    assign pack_cols_mobile = slot_count | plus: 2 | divided_by: 3
  endif

  assign liquid_products_limit = products_limit
  if liquid_products_limit > 50
    assign liquid_products_limit = 50
  endif
%}
{{ 'pack-bodys4.css' | asset_url | stylesheet_tag }}
<section
  class="pack-ui"
  id="pack-ui-{{ section.id }}"
  data-pack-mode="variable"
  data-section-id="{{ section.id }}"
  data-slot-count="{{ slot_count }}"
  data-collection-handle="{{ pack_collection.handle }}"
  data-products-limit="{{ products_limit }}"
  data-cart-url="{{ routes.cart_add_url }}"
  data-checkout-url="{{ routes.checkout_url }}"
  data-button-default-text="{{ section.settings.buy_button_label | escape }}"
  data-button-loading-text="{{ section.settings.loading_button_label | escape }}"
  data-metafield-namespace="{{ section.settings.metafield_namespace | escape }}"
  data-metafield-key="{{ section.settings.metafield_key | escape }}"
  style="
    --pack-bg: {{ section.settings.background_color }};
    --pack-pt: {{ section.settings.padding_top }}px;
    --pack-pr: {{ section.settings.padding_right }}px;
    --pack-pb: {{ section.settings.padding_bottom }}px;
    --pack-pl: {{ section.settings.padding_left }}px;
    --pack-mt: {{ section.settings.margin_top }}px;
    --pack-mb: {{ section.settings.margin_bottom }}px;
    --pack-cols: {{ pack_cols }};
    --pack-cols-mobile: {{ pack_cols_mobile }};
    --pack-rows: {{ pack_rows }};
    --pack-rows-mobile: {{ pack_rows_mobile }};
  "
  {% if pack_collection == blank %}
    data-empty="true"
  {% endif %}
>
  {% if section.settings.heading != blank %}
    <h2 class="pack-ui__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  {% if pack_collection == blank %}
    <p class="pack-ui__empty">
      Selecciona una coleccion en la configuracion de la seccion para mostrar productos.
    </p>
  {% else %}
    <div class="pack-slots" data-slot-count="{{ slot_count }}">
      {% for index in (1..slot_count) %}
        <button
          type="button"
          class="slot"
          data-slot="{{ index }}"
          aria-label="Seleccionar producto {{ index }}"
        >
          <span class="slot__plus">+</span>
        </button>
      {% endfor %}
    </div>

    <div class="pack-actions">
      <button type="button" id="pack-buy-{{ section.id }}" class="pack-button pack-button--buy">
        {{ section.settings.buy_button_label }}
      </button>
      <button type="button" id="pack-reset-{{ section.id }}" class="pack-button pack-button--reset">
        {{ section.settings.reset_button_label }}
      </button>
    </div>

    <p class="pack-ui__message" data-pack-message hidden></p>

    <div class="pack-modal" data-pack-modal hidden>
      <div class="modal-content" role="dialog" aria-modal="true" aria-label="Seleccionar producto">
        <button type="button" class="modal-close" data-close-products aria-label="Cerrar">x</button>
        <div class="products" data-products-grid></div>
        <div class="pack-pagination" data-pagination></div>
      </div>
    </div>

    <div class="pack-modal" data-variant-modal hidden>
      <div class="modal-content modal-content--narrow" role="dialog" aria-modal="true" aria-label="Seleccionar variante">
        <button type="button" class="modal-close" data-close-variants aria-label="Cerrar">x</button>
        <div data-variant-content></div>
      </div>
    </div>

    <script type="application/json" data-pack-products>
      [
        {% for product in pack_collection.products limit: liquid_products_limit %}
          {% liquid
            assign color_option_index = 0
            for option in product.options_with_values
              assign option_name = option.name | downcase
              if option_name contains 'talla' or option_name contains 'size'
                continue
              endif
              assign color_option_index = forloop.index0
              break
            endfor
          %}
          {% if product.featured_media %}
            {% assign featured = product.featured_media | image_url: width: 600 %}
          {% else %}
            {% assign featured = '' %}
          {% endif %}
          {
            "id": {{ product.id | json }},
            "handle": {{ product.handle | json }},
            "name": {{ product.title | json }},
            "img": {{ featured | json }},
            "available": {{ product.available | json }},
            "is_variable": {% if product.has_only_default_variant %}false{% else %}true{% endif %},
            "color_option_index": {{ color_option_index | json }},
            "second_by_color": {
              {% assign first_color_entry = true %}
              {% for variant in product.variants %}
                {% assign second_image = '' %}
                {% assign second_meta = variant.metafields[section.settings.metafield_namespace][section.settings.metafield_key] %}
                {% if second_meta != blank %}
                  {% if second_meta.value.url %}
                    {% assign second_image = second_meta.value | image_url: width: 600 %}
                  {% elsif second_meta.type == 'file_reference' %}
                    {% assign second_image = second_meta | image_url: width: 600 %}
                  {% elsif second_meta.value contains 'http' or second_meta.value contains '//' %}
                    {% assign second_image = second_meta.value %}
                  {% else %}
                    {% assign second_image = second_meta | image_url: width: 600 %}
                  {% endif %}
                {% endif %}
                {% if second_image != blank %}
                  {% assign color_value = variant.options[color_option_index] %}
                  {% unless first_color_entry %},{% endunless %}
                  {% assign first_color_entry = false %}
                  {{ color_value | json }}: {{ second_image | json }}
                {% endif %}
              {% endfor %}
            },
            "default_variant_id": {{ product.selected_or_first_available_variant.id | json }},
            "variants": [
              {% for variant in product.variants %}
                {% if variant.featured_media %}
                  {% assign variant_image = variant.featured_media | image_url: width: 600 %}
                {% elsif product.featured_media %}
                  {% assign variant_image = product.featured_media | image_url: width: 600 %}
                {% else %}
                  {% assign variant_image = '' %}
                {% endif %}
                {% assign second_image = '' %}
                {% assign second_meta = variant.metafields[section.settings.metafield_namespace][section.settings.metafield_key] %}
                {% if second_meta != blank %}
                  {% if second_meta.value.url %}
                    {% assign second_image = second_meta.value | image_url: width: 600 %}
                  {% elsif second_meta.type == 'file_reference' %}
                    {% assign second_image = second_meta | image_url: width: 600 %}
                  {% elsif second_meta.value contains 'http' or second_meta.value contains '//' %}
                    {% assign second_image = second_meta.value %}
                  {% else %}
                    {% assign second_image = second_meta | image_url: width: 600 %}
                  {% endif %}
                {% endif %}
                {
                  "id": {{ variant.id | json }},
                  "title": {{ variant.title | json }},
                  "available": {{ variant.available | json }},
                  "image": {{ variant_image | json }},
                  "second_image": {{ second_image | json }},
                  "options": {{ variant.options | json }}
                }{% unless forloop.last %},{% endunless %}
              {% endfor %}
            ],
            "options": [
              {% for option in product.options_with_values %}
                {
                  "name": {{ option.name | json }},
                  "values": {{ option.values | json }}
                }{% unless forloop.last %},{% endunless %}
              {% endfor %}
            ]
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    </script>
  {% endif %}
</section>
<script src="{{ 'pack-bodys4.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Pack Bodys 4",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titulo",
      "default": "Arma tu pack"
    },
    {
      "type": "header",
      "content": "Espaciado y fondo"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding superior",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding inferior",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding izquierdo",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding derecho",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Margin superior",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Margin inferior",
      "default": 0
    },
    {
      "type": "header",
      "content": "Segunda imagen de variante"
    },
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Namespace del metafield",
      "default": "custom",
      "info": "Crea en Shopify Admin un metafield de variante: custom.second_image (tipo archivo/imagen). Una imagen por color aplica a todas las tallas."
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Key del metafield",
      "default": "second_image"
    },
    {
      "type": "header",
      "content": "Pack builder"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Coleccion de productos"
    },
    {
      "type": "range",
      "id": "slot_count",
      "min": 1,
      "max": 15,
      "step": 1,
      "label": "Cantidad de espacios",
      "info": "4 = 1 fila, 6 a 12 = 2 filas, 13 a 15 = 3 filas",
      "default": 4
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 4,
      "max": 150,
      "step": 2,
      "label": "Productos a cargar",
      "info": "Hasta 50 se cargan directo; de 52 a 150 se cargan por Ajax",
      "default": 24
    },
    {
      "type": "text",
      "id": "buy_button_label",
      "label": "Texto del boton comprar",
      "default": "Comprar ahora"
    },
    {
      "type": "text",
      "id": "loading_button_label",
      "label": "Texto del boton cargando",
      "default": "Procesando..."
    },
    {
      "type": "text",
      "id": "reset_button_label",
      "label": "Texto del boton reset",
      "default": "Borrar todo"
    }
  ],
  "presets": [
    {
      "name": "Pack Bodys 4"
    }
  ]
}
{% endschema %}