{{ 'pack-discount-rules.css' | asset_url | stylesheet_tag }}

<script type="application/json" data-pack-discount-rules>
[
{%- assign first_rule = true -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'rule' and block.settings.enabled and block.settings.collection != blank -%}
    {%- unless first_rule -%},{%- endunless -%}
    {%- assign first_rule = false -%}
    {%- assign rule_collection = block.settings.collection -%}
  {
    "id": {{ block.id | json }},
    "title": {{ block.settings.title | default: rule_collection.title | json }},
    "enabled": true,
    "priority": {{ block.settings.priority | default: 10 }},
    "exclusive": {{ block.settings.exclusive | json }},
    "count_mode": {{ block.settings.count_mode | json }},
    "filter": {
      "collection": {{ rule_collection.handle | json }}
    },
    "ranges": {% if block.settings.tiers_json != blank %}{{ block.settings.tiers_json }}{% else %}[]{% endif %},
    "conditions": {% if block.settings.conditions_json != blank %}{{ block.settings.conditions_json }}{% else %}[]{% endif %}
  }
  {%- endif -%}
{%- endfor -%}
]
</script>

<script src="{{ 'pack-discount-rules.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Reglas de precio pack",
  "tag": "section",
  "class": "section-pack-discount-rules",
  "settings": [
    {
      "type": "paragraph",
      "content": "Replica reglas tipo Flycart (Discount Rules): filtra por coleccion, cuenta cantidades del pack y aplica tramos de precio. El pack debe usar la misma coleccion que la regla."
    },
    {
      "type": "paragraph",
      "content": "Ejemplo tiers_json: [{\"min\":1,\"max\":6,\"type\":\"fixed_price_per_item\",\"value\":3000000,\"label\":\"Hasta 6\"},{\"min\":7,\"max\":10,\"type\":\"fixed_price_per_item\",\"value\":1855700,\"label\":\"7-10 uds\"}] — value en centavos (25000 COP = 2500000)."
    }
  ],
  "blocks": [
    {
      "type": "rule",
      "name": "Regla por coleccion",
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Activa",
          "default": true
        },
        {
          "type": "text",
          "id": "title",
          "label": "Nombre interno",
          "default": "Regla pack"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Coleccion (filtro)"
        },
        {
          "type": "select",
          "id": "count_mode",
          "label": "Contar cantidades por",
          "default": "filter_set",
          "options": [
            {
              "value": "filter_set",
              "label": "Toda la coleccion del pack (como Flycart)"
            },
            {
              "value": "individual_product",
              "label": "Por producto individual"
            }
          ]
        },
        {
          "type": "textarea",
          "id": "tiers_json",
          "label": "Tramos de precio (JSON)",
          "default": "[{\"min\":1,\"max\":3,\"type\":\"fixed_price_per_item\",\"value\":3000000,\"label\":\"1-3\"},{\"min\":4,\"max\":10,\"type\":\"fixed_price_per_item\",\"value\":2500000,\"label\":\"4-10\"}]",
          "info": "type: fixed_price_per_item | percentage | fixed_discount. min/max = cantidad en el pack."
        },
        {
          "type": "textarea",
          "id": "conditions_json",
          "label": "Condiciones extra (JSON, opcional)",
          "default": "[]",
          "info": "Ej: [{\"type\":\"payment_method\",\"value\":\"cod\"}] o [{\"type\":\"min_quantity\",\"value\":4}]"
        },
        {
          "type": "range",
          "id": "priority",
          "min": 0,
          "max": 100,
          "step": 1,
          "label": "Prioridad (mayor gana primero)",
          "default": 10
        },
        {
          "type": "checkbox",
          "id": "exclusive",
          "label": "Exclusiva (ignorar otras reglas si coincide)",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reglas de precio pack",
      "blocks": [
        {
          "type": "rule",
          "settings": {
            "title": "Pack 4 precio landing",
            "tiers_json": "[{\"min\":4,\"max\":4,\"type\":\"fixed_price_per_item\",\"value\":2500000,\"label\":\"Pack 4\"},{\"min\":1,\"max\":3,\"type\":\"fixed_price_per_item\",\"value\":3000000,\"label\":\"Menos de 4\"}]"
          }
        }
      ]
    }
  ]
}
{% endschema %}
