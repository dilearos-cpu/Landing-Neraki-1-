{{ 'caletzza-pauly.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="cz-category-grid section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="cz-category-grid__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <ul class="cz-category-grid__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign coll = block.settings.collection -%}
        <li {{ block.shopify_attributes }}>
          <a
            class="cz-category-grid__link"
            href="{{ coll.url | default: block.settings.link | default: '#' }}"
          >
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 600
                | image_tag: class: 'cz-category-grid__image', loading: 'lazy', alt: block.settings.title
              }}
            {%- elsif coll.featured_image -%}
              {{
                coll.featured_image
                | image_url: width: 600
                | image_tag: class: 'cz-category-grid__image', loading: 'lazy', alt: coll.title
              }}
            {%- else -%}
              {{ 'collection-apparel-1' | placeholder_svg_tag: 'cz-category-grid__image' }}
            {%- endif -%}
            <div class="cz-category-grid__overlay">
              <span class="cz-category-grid__title">
                {{ block.settings.title | default: coll.title | escape }}
              </span>
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Grid categorías (Pauly)",
  "tag": "section",
  "class": "section-pauly-category-grid",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Comprar por categoría"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding superior",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding inferior",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Categoría"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace alternativo"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen personalizada"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grid categorías (Pauly)",
      "blocks": [
        { "type": "category", "settings": { "title": "Lo nuevo" } },
        { "type": "category", "settings": { "title": "Bodys" } },
        { "type": "category", "settings": { "title": "Ropa interior" } },
        { "type": "category", "settings": { "title": "Rebajas" } }
      ]
    }
  ]
}
{% endschema %}
