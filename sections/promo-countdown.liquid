{{ 'promo-countdown.css' | asset_url | stylesheet_tag }}

<section
  class="promo-countdown"
  id="promo-countdown-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-duration-hours="{{ section.settings.duration_hours }}"
  data-storage-key="promo-countdown-{{ section.id }}"
  style="
    --promo-bg: {{ section.settings.background_color }};
    --promo-number-color: {{ section.settings.number_color }};
    --promo-bar-fill: {{ section.settings.bar_fill_color }};
  "
>
  <div class="promo-countdown__inner">
    <div class="promo-countdown__timer-box">
      <div class="promo-countdown__timer">
        <div class="promo-countdown__unit">
          <span class="promo-countdown__value" data-hours>00</span>
          <span class="promo-countdown__label">{{ section.settings.hours_label }}</span>
        </div>
        <div class="promo-countdown__unit">
          <span class="promo-countdown__value" data-minutes>00</span>
          <span class="promo-countdown__label">{{ section.settings.minutes_label }}</span>
        </div>
        <div class="promo-countdown__unit">
          <span class="promo-countdown__value" data-seconds>00</span>
          <span class="promo-countdown__label">{{ section.settings.seconds_label }}</span>
        </div>
      </div>
    </div>

    <p class="promo-countdown__promos">
      {{ section.settings.promos_prefix }}
      <strong data-promos-count>{{ section.settings.promos_available }}</strong>
      {{ section.settings.promos_suffix }}
    </p>

    <div class="promo-countdown__bar" aria-hidden="true">
      <div
        class="promo-countdown__bar-fill"
        data-bar-fill
        style="width: {{ section.settings.promos_available | times: 100 | divided_by: section.settings.promos_total | at_most: 100 }}%;"
      >
        <span data-bar-label>{{ section.settings.promos_available }} {{ section.settings.units_label }}</span>
      </div>
    </div>

    <p class="promo-countdown__instruction">
      <strong>{{ section.settings.instruction_bold }}</strong>
      {{ section.settings.instruction_regular }}
    </p>
  </div>

  <script type="application/json" data-promo-settings>
    {
      "promosAvailable": {{ section.settings.promos_available | json }},
      "promosTotal": {{ section.settings.promos_total | json }},
      "unitsLabel": {{ section.settings.units_label | json }}
    }
  </script>
</section>

<script src="{{ 'promo-countdown.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Contador promo 24h",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#D2B49B"
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Color de numeros",
      "default": "#D2B49B"
    },
    {
      "type": "color",
      "id": "bar_fill_color",
      "label": "Color barra de progreso",
      "default": "#E53935"
    },
    {
      "type": "range",
      "id": "duration_hours",
      "min": 1,
      "max": 48,
      "step": 1,
      "label": "Duracion del contador (horas)",
      "default": 24
    },
    {
      "type": "text",
      "id": "hours_label",
      "label": "Etiqueta horas",
      "default": "horas"
    },
    {
      "type": "text",
      "id": "minutes_label",
      "label": "Etiqueta minutos",
      "default": "minutos"
    },
    {
      "type": "text",
      "id": "seconds_label",
      "label": "Etiqueta segundos",
      "default": "segundos"
    },
    {
      "type": "text",
      "id": "promos_prefix",
      "label": "Texto antes del numero de promos",
      "default": "Solo"
    },
    {
      "type": "number",
      "id": "promos_available",
      "label": "Promos disponibles",
      "default": 5
    },
    {
      "type": "text",
      "id": "promos_suffix",
      "label": "Texto despues del numero de promos",
      "default": "promos disponibles"
    },
    {
      "type": "number",
      "id": "promos_total",
      "label": "Total de promos (para la barra)",
      "default": 25
    },
    {
      "type": "text",
      "id": "units_label",
      "label": "Texto dentro de la barra",
      "default": "unds"
    },
    {
      "type": "text",
      "id": "instruction_bold",
      "label": "Texto instruccion (negrita)",
      "default": "Dale click a los recuadros en blanco"
    },
    {
      "type": "text",
      "id": "instruction_regular",
      "label": "Texto instruccion (normal)",
      "default": "para escoger 4 diseños a tu gusto."
    }
  ],
  "presets": [
    {
      "name": "Contador promo 24h"
    }
  ]
}
{% endschema %}
