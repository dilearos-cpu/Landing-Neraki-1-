PORT=3000
SHOPIFY_SHOP_DOMAIN=caletzza.myshopify.com
SHOPIFY_API_VERSION=2025-01

# Dev Dashboard (recomendado): Client ID + Secret — el token se renueva solo cada 24h
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# App heredada (alternativa): token fijo shpat_
# SHOPIFY_ADMIN_API_TOKEN=

# Mismo valor que Client secret (para validar app proxy)
SHOPIFY_API_SECRET=

# Solo para desarrollo local sin firma de app proxy
ALLOW_UNSIGNED_PROXY=false
