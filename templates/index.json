        "custom_liquid": "<div class=\"promo-countdown-wrap\" data-anchor=\"2025-05-05T23:59:59Z\" data-period-hours=\"24\">\n  <div class=\"promo-countdown-box\" role=\"timer\" aria-live=\"polite\">\n    <div class=\"pc-col\">\n      <div class=\"pc-num\" data-hh>00</div>\n      <div class=\"pc-lbl\">horas</div>\n    </div>\n    <div class=\"pc-col\">\n      <div class=\"pc-num\" data-mm>00</div>\n      <div class=\"pc-lbl\">minutos</div>\n    </div>\n    <div class=\"pc-col\">\n      <div class=\"pc-num\" data-ss>00</div>\n      <div class=\"pc-lbl\">segundos</div>\n    </div>\n  </div>\n\n  <div class=\"promo-countdown-sub\">Solo 5 promos disponibles</div>\n</div>\n\n<style>\n  /* Fondo blanco como pediste */\n  .promo-countdown-wrap{\n    width:100%;\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    justify-content:center;\n    padding: 14px 0 12px;\n    background:#ffffff;\n  }\n\n  /* Caja rosada más larga + un poquito más ancha */\n  .promo-countdown-box{\n    background:#f2a7a1;\n    border-radius: 0px;\n    width: min(520px, 92vw);   /* <-- más larga */\n    padding: 12px 28px 10px;   /* <-- más ancha */\n    display:flex;\n    gap: 52px;                 /* más separación como en la captura */\n    align-items:flex-end;\n    justify-content:center;\n  }\n\n  .pc-col{\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    justify-content:center;\n    min-width: 84px;           /* más ancho cada bloque */\n  }\n\n  .pc-num{\n    color:#fff;\n    font-weight: 800;\n    font-size: 44px;\n    line-height: 1;\n    letter-spacing: .02em;\n    font-variant-numeric: tabular-nums;\n  }\n\n  .pc-lbl{\n    margin-top: 4px;\n    color: rgba(255,255,255,.95);\n    font-weight: 600;\n    font-size: 12px;\n    line-height: 1;\n    text-transform: lowercase;\n  }\n\n  .promo-countdown-sub{\n    margin-top: 10px;\n    color:#6f6b62;\n    font-weight: 700;\n    font-size: 18px;\n    line-height: 1.1;\n    text-align:center;\n  }\n\n  /* Responsive */\n  @media (max-width: 480px){\n    .promo-countdown-box{\n      width: min(420px, 92vw);\n      gap: 34px;\n      padding: 12px 18px 10px;\n    }\n    .pc-col{ min-width: 70px; }\n    .pc-num{ font-size: 40px; }\n    .promo-countdown-sub{ font-size: 16px; }\n  }\n</style>\n\n<script>\n(() => {\n  const wrap = document.querySelector('.promo-countdown-wrap');\n  if (!wrap) return;\n\n  const anchorStr = wrap.getAttribute('data-anchor');\n  const periodHours = parseFloat(wrap.getAttribute('data-period-hours') || '24');\n  const periodMs = periodHours * 60 * 60 * 1000;\n\n  const hhEl = wrap.querySelector('[data-hh]');\n  const mmEl = wrap.querySelector('[data-mm]');\n  const ssEl = wrap.querySelector('[data-ss]');\n\n  const pad2 = (n) => String(n).padStart(2, '0');\n  const anchor = new Date(anchorStr);\n  if (isNaN(anchor.getTime())) return;\n\n  function remainingMs(nowMs){\n    const elapsed = nowMs - anchor.getTime();\n    if (elapsed < 0) return -elapsed;\n    const mod = elapsed % periodMs;\n    return periodMs - mod;\n  }\n\n  function tick(){\n    let rem = remainingMs(Date.now());\n    if (rem >= periodMs) rem = periodMs - 1;\n\n    const total = Math.max(0, Math.floor(rem / 1000));\n    const hh = Math.floor(total / 3600);\n    const mm = Math.floor((total % 3600) / 60);\n    const ss = total % 60;\n\n    hhEl.textContent = pad2(hh);\n    mmEl.textContent = pad2(mm);\n    ssEl.textContent = pad2(ss);\n  }\n\n  tick();\n  setInterval(tick, 1000);\n})();\n</script>",
